<Window x:Class="Atletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Atlétikai verseny - Rajtszámok"
        Width="1440" Height="820"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        FontSize="14">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Új versenyző" FontSize="20" FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,16"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Versenyző neve:" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNev" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Versenyszám:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbVersenyszam" Height="32" IsEditable="False" SelectedIndex="-1">
                        <ComboBoxItem Content="100 m"/>
                        <ComboBoxItem Content="200 m"/>
                        <ComboBoxItem Content="400 m"/>
                        <ComboBoxItem Content="800 m"/>
                        <ComboBoxItem Content="1500 m"/>
                        <ComboBoxItem Content="Távolugrás"/>
                        <ComboBoxItem Content="Magasugrás"/>
                        <ComboBoxItem Content="Súlylökés"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Nem:" Margin="0,0,0,7"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbFerfi" Content="Férfi" GroupName="Nem" Margin="0,0,24,0"/>
                        <RadioButton x:Name="rbNo" Content="Nő" GroupName="Nem"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <TextBlock Text="Életkor" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sldEletkor" Minimum="18" Maximum="90" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" VerticalAlignment="Center" ValueChanged="Eletkor_Valtozott"/>
                        <TextBlock x:Name="txtEletkor" Grid.Column="1" Text="18 év" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#19324D"/>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="18 év" Foreground="#52657A"/>
                        <TextBlock Grid.Column="1" Text="90 év" Foreground="#52657A" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,0,0,12">
                    <TextBlock Text="Korábbi rekordok" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkOR" Content="Olimpiai csúcs (OR)" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkVR" Content="Világcsúcs (VR)" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkER" Content="Európa-csúcs (ER)"/>
                </StackPanel>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="Igényelt rajtszám" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtRajtszam" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Üres mező: automatikus kiosztás" FontSize="12" Foreground="#52657A" Margin="0,5,0,12"/>
                    <Button x:Name="btnRegisztral" Content="REGISZTRÁL" Height="36" Background="#DDEBFA" Foreground="#19324D" BorderThickness="0" Click="Regisztral_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="10,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Eredményszűrő:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="cmbRekordSzuro" Grid.Column="1" Height="32" IsEditable="False" SelectedIndex="0" SelectionChanged="Szuro_Valtozott">
                        <ComboBoxItem Content="Összes"/>
                        <ComboBoxItem Content="OR - olimpiai csúcs"/>
                        <ComboBoxItem Content="VR - világcsúcs"/>
                        <ComboBoxItem Content="ER - Európa-csúcs"/>
                    </ComboBox>
                </Grid>

                <DataGrid x:Name="dgVersenyzok"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          RowHeight="32"
                          AlternatingRowBackground="#F4F7FB"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#D4DDE7"
                          BorderThickness="1"
                          ItemsSource="{Binding Versenyzok, Mode=OneWay}">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#19324D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Height" Value="38"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rajtszám" Width="88" Binding="{Binding Rajtszam, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Név" Width="*" Binding="{Binding Nev, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Versenyszám" Width="160" Binding="{Binding Versenyszam, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Nem" Width="70" Binding="{Binding Nem, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Életkor" Width="80" Binding="{Binding Eletkor, Mode=OneWay}"/>
                        <DataGridCheckBoxColumn Header="OR" Width="80" Binding="{Binding OR, Mode=OneWay}"/>
                        <DataGridCheckBoxColumn Header="VR" Width="80" Binding="{Binding VR, Mode=OneWay}"/>
                        <DataGridCheckBoxColumn Header="ER" Width="80" Binding="{Binding ER, Mode=OneWay}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="OR = olimpiai csúcs    |    VR = világcsúcs    |    ER = Európa-csúcs" Foreground="#52657A" Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtLetszam" Grid.Column="0" Text="Látható: 0 / Összesen: 0" Foreground="#52657A" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="btnMentes" Content="FÁJLBA MENTÉS" Width="210" Height="32" Click="Mentes_Click"/>
                <Button Grid.Column="3" x:Name="btnBetoltes" Content="FÁJLBÓL BETÖLTÉS" Width="210" Height="32" Click="Betoltes_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
